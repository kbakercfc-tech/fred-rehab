{
  "name": "Fred's Rehab Tracker",
  "short_name": "Fred's Rehab",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#1e3a5f",
  "theme_color": "#1e3a5f",
  "icons": [
    { "src": "/images/fred.jpg", "sizes": "any", "type": "image/jpeg" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "files": [
        { "name": "media", "accept": ["video/*", "image/*"] }
      ]
    }
  }
}
